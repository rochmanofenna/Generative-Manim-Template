# Copy to .env and fill in. Loaded automatically by create_app() via python-dotenv.

# Set at least one. Whichever provider has a key is used automatically; if both
# are set, OpenAI wins unless you pick a model per request or set DEFAULT_MODEL.
# Leave a provider blank rather than filling in a placeholder.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force a model regardless of which keys are present.
# e.g. claude-opus-5, claude-sonnet-5, gpt-4o
DEFAULT_MODEL=

# Storage backend. "true" (default) writes videos to api/public and serves them
# from the Flask app at /public/<name>.mp4 -- no cloud account needed.
USE_LOCAL_STORAGE=true

# Used to build video URLs when the request host is unavailable.
BASE_URL=http://127.0.0.1:8080

# Only read when USE_LOCAL_STORAGE=false. Requires `pip install google-cloud-storage`.
GOOGLE_CLOUD_FILE=
GOOGLE_BUCKET_NAME=

# Alternative cloud backend. Requires `pip install azure-storage-blob`.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=
